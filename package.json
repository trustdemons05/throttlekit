{
  "name": "throttlekit",
  "version": "0.1.0",
  "description": "Pluggable, framework-agnostic rate-limiting toolkit with 7 algorithms, clock-injected deterministic testing, and zero required dependencies.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".":          { "import": "./dist/index.js",            "require": "./dist/index.cjs" },
    "./express":  { "import": "./dist/adapters/express.js", "require": "./dist/adapters/express.cjs" },
    "./fetch":    { "import": "./dist/adapters/fetch.js",   "require": "./dist/adapters/fetch.cjs" },
    "./redis":    { "import": "./dist/stores/redis.js",     "require": "./dist/stores/redis.cjs" }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "bench": "node benchmark/algorithms.js",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "fast-check": "^3.19.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "ioredis": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
